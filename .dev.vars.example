# Server-side secrets for local `npm run preview` (wrangler pages dev).
# Copy to `.dev.vars` (git-ignored) and fill in. In Cloudflare Pages, set these
# as encrypted environment variables for Production and Preview.

# Owner's inbox that receives enquiries. Never shown on the site.
CONTACT_TO_EMAIL=owner@example.com
# Verified sender on the business domain in Resend.
CONTACT_FROM_EMAIL=Lumina Website <enquiries@lumina.example>
RESEND_API_KEY=re_replace_me
# Cloudflare Turnstile published test secret: always passes.
# Use 2x0000000000000000000000000000000AA to test a failing challenge.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
