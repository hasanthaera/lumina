---
import { site } from '../config/site';

const links: { href: string; label: string; sub?: boolean }[] = [
  { href: '/', label: 'Home' },
  { href: '/services/', label: 'Services' },
  ...site.services.map((s) => ({ href: `/services/${s.slug}/`, label: s.label, sub: true })),
  { href: '/contact/', label: 'Contact us' },
];

const normalise = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const current = normalise(Astro.url.pathname);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/">
      <img class="brand__logo" src="/logo.png" width="329" height="96" alt={`${site.fullName} home`} />
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      hidden
    >
      <span class="nav-toggle__icon" aria-hidden="true"></span>
      Menu
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>
        {
          links.map((link) => (
            <li class={link.sub ? 'site-nav__sub' : undefined}>
              <a href={link.href} aria-current={current === link.href ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  // Collapsible menu below the breakpoint. Without this script the nav simply
  // stays expanded, so it is always usable.
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('site-nav');
  if (toggle && nav) {
    const mq = window.matchMedia('(max-width: 47.99rem)');
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('is-open', open);
    };
    const sync = () => {
      toggle.hidden = !mq.matches;
      nav.classList.toggle('is-collapsible', mq.matches);
      if (!mq.matches) setOpen(false);
    };
    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    mq.addEventListener('change', sync);
    sync();
  }
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-3);
  }

  .site-header {
    border-top: 4px solid var(--color-accent);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius);
  }

  .brand__logo {
    display: block;
    height: 48px;
    width: auto;
  }

  @media (min-width: 48rem) {
    .brand__logo {
      height: 56px;
    }
  }

  .nav-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    border: 2px solid var(--color-brand);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-brand);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .nav-toggle[hidden] {
    display: none;
  }

  .nav-toggle__icon,
  .nav-toggle__icon::before,
  .nav-toggle__icon::after {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
  }

  .nav-toggle__icon {
    position: relative;
  }

  .nav-toggle__icon::before,
  .nav-toggle__icon::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .nav-toggle__icon::before {
    top: -6px;
  }

  .nav-toggle__icon::after {
    top: 6px;
  }

  .site-nav {
    width: 100%;
  }

  .site-nav.is-collapsible:not(.is-open) {
    display: none;
  }

  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .site-nav a {
    display: block;
    padding: var(--space-3) var(--space-2);
    min-height: 44px;
    color: var(--color-text);
    text-decoration: none;
    font-weight: 500;
  }

  .site-nav__sub a {
    padding-left: var(--space-5);
  }

  .site-nav a:hover {
    color: var(--color-brand);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 3px;
  }

  .site-nav a[aria-current='page'] {
    color: var(--color-brand);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.35em;
  }

  @media (min-width: 48rem) {
    .site-nav {
      width: auto;
    }

    .site-nav ul {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-1);
    }

    .site-nav a,
    .site-nav__sub a {
      padding: var(--space-2) var(--space-3);
      min-height: 0;
    }
  }
</style>
